# Copiez ce fichier en ".env" puis remplissez UNE clé au minimum.
# Ne partagez jamais votre fichier .env (il est dans .gitignore).

# Fournisseur actif : groq | gemini | openrouter | ollama
PROVIDER=groq

# https://console.groq.com/keys
GROQ_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optionnel : forcer un autre modèle que celui par défaut (voir config.py)
# MODEL=qwen/qwen3.6-27b
